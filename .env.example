# ---- TorBox ----
# Get this from https://torbox.app/settings (API section).
TORBOX_API_KEY=your-torbox-api-key-here
# TORBOX_BASE_URL=https://api.torbox.app/v1
# Seeding preference sent to TorBox: 1=auto, 2=always seed, 3=never seed.
# TORBOX_SEED=1

# ---- qBittorrent login (what you enter in Sonarr/Radarr) ----
QBIT_USER=admin
QBIT_PASS=adminadmin

# ---- Storage / paths ----
# Where this container writes finished files (its own mount).
DOWNLOAD_DIR=/downloads
# The path Sonarr/Radarr see for the same files. Leave unset if they also use
# /downloads. Set it if their internal path differs (e.g. /data/downloads).
# SAVE_PATH=/downloads

# ---- File ownership (Unraid / linuxserver style) ----
# On Unraid use PUID=99 and PGID=100 so files match your other *arr apps.
# PUID=1000
# PGID=1000
# UMASK=022

# ---- Behaviour ----
# POLL_INTERVAL=15              # seconds between TorBox status polls
# MAX_PARALLEL_DOWNLOADS=4      # concurrent file downloads from TorBox CDN
# MAX_PARALLEL_TORRENTS=2       # torrents pulled locally at once (0 = unlimited)
# MAX_DOWNLOAD_SPEED=0          # aggregate cap in MiB/s (0 = unlimited)
# STALL_TIMEOUT=90              # seconds with no data before a stream retries
# DOWNLOAD_RETRIES=4            # attempts per file (fresh CDN link + resume)
# TORBOX_CLEANUP_HOURS=24       # delete the TorBox cloud copy this long after the
#                               # local download finishes (0 = never); frees your
#                               # TorBox active-torrent slots, local files are kept
# DELETE_FROM_TORBOX_ON_REMOVE=true  # remove the cloud torrent when *arr removes it
# LOG_LEVEL=INFO
